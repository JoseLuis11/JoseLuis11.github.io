---
import CallToAction from '@components/CallToAction.astro';
import Capabilities from '@components/Capabilities.astro';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import Process from '@components/Process.astro';
import Projects from '@components/Projects.astro';
import Services from '@components/Services.astro';
import ScrollToTop from '@components/ScrollToTop.astro';
import TrustStrip from '@components/TrustStrip.astro';
import WhySolwave from '@components/WhySolwave.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

const title = 'Solwave | Build. Flow. Scale.';
const description = 'Modern software systems designed for clarity, speed and scale.';
---

<BaseLayout title={title} description={description}>
  <div class="page-background" aria-hidden="true"></div>
  <main class="site-shell">
    <Header />
    <Hero />
    <TrustStrip />
    <Services />
    <Process />
    <Capabilities />
    <Projects />
    <WhySolwave />
    <CallToAction />
    <Footer />
  </main>
  <ScrollToTop />
</BaseLayout>
