---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getContent } from '@data/site';

const content = getContent('es');
const { notFound } = content;
---

<BaseLayout title={notFound.title} description={notFound.description} lang={content.locale} noindex>
  <main class="not-found">
    <a class="logo logo--md" href="/es/" aria-label={notFound.homeAriaLabel}>
      <span class="logo__mark brand-mark" aria-hidden="true"></span>
      <span class="logo__text">SOLWAVE</span>
    </a>
    <p class="eyebrow">{notFound.eyebrow}</p>
    <h1>{notFound.heading}</h1>
    <p>{notFound.body}</p>
    <a class="button button--primary" href="/es/">{notFound.homeLabel}</a>
  </main>
</BaseLayout>
