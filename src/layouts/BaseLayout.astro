---
import '@styles/main.scss';
import type { Locale } from '@data/site';
import { localizedHomePaths } from '@data/site';

type Props = {
  title: string;
  description: string;
  lang: Locale;
  noindex?: boolean;
};

const productionUrl = 'https://www.solwave.dev';
const canonicalUrl = new URL(Astro.url.pathname, productionUrl).toString();
const socialImageUrl = new URL('/og-image.png', productionUrl).toString();
const { title, description, lang, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={new URL(localizedHomePaths.es, productionUrl).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(localizedHomePaths.en, productionUrl).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizedHomePaths.es, productionUrl).toString()} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/solwave-gradient.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon-256.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
