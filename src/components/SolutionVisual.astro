---
import type { Solution } from '@data/site';

type Props = {
  variant: Solution['variant'];
};

const { variant } = Astro.props;
---

{
  variant === 'blue' && (
    <svg class="solution-card__visual" viewBox="0 0 900 300" focusable="false">
      <circle cx="770" cy="64" r="130" class="solution-card__glow solution-card__glow--cyan" />
      <circle cx="100" cy="265" r="160" class="solution-card__glow solution-card__glow--violet" />
      <rect x="52" y="42" width="520" height="216" rx="18" class="solution-card__screen solution-card__screen--dark" />
      <rect x="78" y="70" width="182" height="70" rx="12" class="solution-card__tile solution-card__tile--light" />
      <rect x="286" y="70" width="118" height="70" rx="12" class="solution-card__tile solution-card__tile--blue" />
      <rect x="422" y="70" width="118" height="70" rx="12" class="solution-card__tile solution-card__tile--blue" />
      <rect x="78" y="164" width="462" height="64" rx="12" class="solution-card__tile solution-card__tile--navy" />
      <path d="M99 202h70l27-23 44 29 50-41 76 45 60-28 82 18" class="solution-card__chart" />
      <rect x="100" y="92" width="100" height="10" rx="5" class="solution-card__line solution-card__line--strong" />
      <rect x="100" y="112" width="132" height="10" rx="5" class="solution-card__line solution-card__line--soft" />
      <rect x="308" y="94" width="58" height="11" rx="6" class="solution-card__accent solution-card__accent--cyan" />
      <rect x="444" y="94" width="58" height="11" rx="6" class="solution-card__accent solution-card__accent--orange" />
      <rect x="614" y="54" width="226" height="194" rx="20" class="solution-card__screen solution-card__screen--light" />
      <rect x="638" y="82" width="74" height="74" rx="14" class="solution-card__tile solution-card__tile--pale" />
      <rect x="730" y="86" width="80" height="10" rx="5" class="solution-card__line solution-card__line--ink" />
      <rect x="730" y="108" width="62" height="10" rx="5" class="solution-card__line solution-card__line--muted" />
      <rect x="638" y="178" width="172" height="12" rx="6" class="solution-card__line solution-card__line--pale" />
      <rect x="638" y="204" width="134" height="12" rx="6" class="solution-card__line solution-card__line--pale" />
    </svg>
  )
}

{
  variant === 'light' && (
    <svg class="solution-card__visual" viewBox="0 0 900 300" focusable="false">
      <path d="M79 72h188M79 102h132M79 132h232M608 228h180M638 198h128" class="solution-card__ghost-lines" />
      <rect x="70" y="58" width="190" height="72" rx="16" class="solution-card__node" />
      <rect x="96" y="82" width="90" height="10" rx="5" class="solution-card__line solution-card__line--ink" />
      <rect x="96" y="104" width="128" height="9" rx="5" class="solution-card__line solution-card__line--muted" />
      <rect x="336" y="58" width="190" height="72" rx="16" class="solution-card__node" />
      <rect x="362" y="82" width="110" height="10" rx="5" class="solution-card__line solution-card__line--ink" />
      <rect x="362" y="104" width="132" height="9" rx="5" class="solution-card__line solution-card__line--muted" />
      <rect x="602" y="58" width="190" height="72" rx="16" class="solution-card__node" />
      <rect x="628" y="82" width="82" height="10" rx="5" class="solution-card__line solution-card__line--ink" />
      <rect x="628" y="104" width="130" height="9" rx="5" class="solution-card__line solution-card__line--muted" />
      <path d="M260 94h76M526 94h76" class="solution-card__connector" />
      <path d="M323 78l15 16-15 16M589 78l15 16-15 16" class="solution-card__connector-arrow" />
      <rect x="178" y="178" width="544" height="74" rx="18" class="solution-card__screen solution-card__screen--charcoal" />
      <circle cx="222" cy="215" r="16" class="solution-card__accent solution-card__accent--cyan" />
      <rect x="258" y="198" width="170" height="10" rx="5" class="solution-card__line solution-card__line--bright" />
      <rect x="258" y="222" width="254" height="10" rx="5" class="solution-card__line solution-card__line--slate" />
      <rect x="586" y="198" width="86" height="34" rx="17" class="solution-card__pill" />
      <circle cx="655" cy="215" r="10" class="solution-card__accent solution-card__accent--green" />
    </svg>
  )
}

{
  variant === 'warm' && (
    <svg class="solution-card__visual" viewBox="0 0 900 300" focusable="false">
      <path d="M0 245c142-48 270-48 384 0s244 48 386-2c48-17 91-22 130-17v74H0z" class="solution-card__warm-wave" />
      <rect x="86" y="48" width="498" height="220" rx="18" class="solution-card__browser" />
      <path d="M86 66a18 18 0 0 1 18-18h462a18 18 0 0 1 18 18v16H86Z" class="solution-card__browser-bar" />
      <circle cx="113" cy="65" r="5" class="solution-card__accent solution-card__accent--orange" />
      <circle cx="132" cy="65" r="5" class="solution-card__accent solution-card__accent--yellow" />
      <circle cx="151" cy="65" r="5" class="solution-card__accent solution-card__accent--green" />
      <rect x="116" y="112" width="194" height="16" rx="8" class="solution-card__line solution-card__line--heading" />
      <rect x="116" y="142" width="240" height="10" rx="5" class="solution-card__line solution-card__line--muted" />
      <rect x="116" y="164" width="178" height="10" rx="5" class="solution-card__line solution-card__line--muted" />
      <rect x="116" y="202" width="92" height="30" rx="15" class="solution-card__button-shape" />
      <rect x="344" y="108" width="190" height="126" rx="16" class="solution-card__tile solution-card__tile--pale" />
      <rect x="366" y="130" width="74" height="74" rx="14" class="solution-card__accent solution-card__accent--orange" />
      <rect x="456" y="132" width="50" height="9" rx="5" class="solution-card__line solution-card__line--ink" />
      <rect x="456" y="154" width="58" height="9" rx="5" class="solution-card__line solution-card__line--muted" />
      <rect x="456" y="176" width="42" height="9" rx="5" class="solution-card__line solution-card__line--muted" />
      <rect x="618" y="88" width="170" height="156" rx="22" class="solution-card__phone" />
      <rect x="642" y="118" width="122" height="72" rx="14" class="solution-card__phone-screen" />
      <rect x="642" y="208" width="78" height="10" rx="5" class="solution-card__line solution-card__line--bright" />
    </svg>
  )
}
