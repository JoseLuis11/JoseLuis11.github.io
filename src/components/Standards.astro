---
import SectionHeading from './SectionHeading.astro';
import { standards } from '@data/site';
---

<section class="section section-shell" aria-labelledby="standards-title">
  <SectionHeading eyebrow="Agency standards" title="Built with the discipline serious software needs." />

  <div class="standards-grid">
    {
      standards.map((standard, index) => (
        <article class="standard-card">
          <span class="standard-card__number">{String(index + 1).padStart(2, '0')}</span>
          <h3>{standard.title}</h3>
          <p>{standard.description}</p>
        </article>
      ))
    }
  </div>
</section>
