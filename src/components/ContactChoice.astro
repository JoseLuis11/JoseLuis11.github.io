---
import type { SiteContent } from '@data/site';

type Props = {
  label: string;
  content: SiteContent['contact'];
  compact?: boolean;
};

const { label, content, compact = false } = Astro.props;
const email = 'hello@solwave.dev';
const whatsappNumber = '526462239495';
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(content.whatsappText)}`;
const menuId = `contact-choice-${compact ? 'compact' : 'full'}-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<div class:list={['contact-choice', { 'contact-choice--compact': compact }]}>
  <button
    class:list={['button', 'button--primary', { 'button--compact': compact }]}
    type="button"
    aria-expanded="false"
    aria-controls={menuId}
    data-contact-choice-trigger
  >
    {label}
  </button>
  <div class="contact-choice__menu" id={menuId} aria-label={content.menuLabel} data-contact-choice-menu hidden>
    <p>{content.menuLabel}</p>
    <a class="contact-choice__option" href={`mailto:${email}`} data-contact-choice-option>
      <span class="contact-choice__icon" aria-hidden="true">@</span>
      <span>
        <strong>{content.emailTitle}</strong>
        <small>{content.emailDescription}</small>
      </span>
    </a>
    <a
      class="contact-choice__option"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-contact-choice-option
    >
      <span class="contact-choice__icon contact-choice__icon--whatsapp" aria-hidden="true">WA</span>
      <span>
        <strong>{content.whatsappTitle}</strong>
        <small>{content.whatsappDescription}</small>
      </span>
    </a>
  </div>
</div>

<script is:inline>
  if (!window.__solwaveContactChoiceReady) {
    window.__solwaveContactChoiceReady = true;
    const closeTimers = new WeakMap();
    const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const closeChoice = (choice, shouldFocus = false) => {
      const trigger = choice.querySelector('[data-contact-choice-trigger]');
      const menu = choice.querySelector('[data-contact-choice-menu]');
      const existingTimer = closeTimers.get(choice);

      if (existingTimer) {
        window.clearTimeout(existingTimer);
        closeTimers.delete(choice);
      }

      choice.classList.remove('is-open');
      trigger?.setAttribute('aria-expanded', 'false');

      if (menu) {
        if (prefersReducedMotion()) {
          choice.classList.remove('is-closing');
          menu.setAttribute('hidden', '');
        } else {
          choice.classList.add('is-closing');

          const timer = window.setTimeout(() => {
            choice.classList.remove('is-closing');
            menu.setAttribute('hidden', '');
            closeTimers.delete(choice);
          }, 150);

          closeTimers.set(choice, timer);
        }
      }

      if (shouldFocus) {
        trigger?.focus();
      }
    };

    const closeAllChoices = (exceptChoice = null) => {
      document.querySelectorAll('.contact-choice.is-open').forEach((choice) => {
        if (choice !== exceptChoice) {
          closeChoice(choice);
        }
      });
    };

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest?.('[data-contact-choice-trigger]');

      if (trigger) {
        const choice = trigger.closest('.contact-choice');
        const menu = choice.querySelector('[data-contact-choice-menu]');
        const willOpen = !choice.classList.contains('is-open');
        const existingTimer = closeTimers.get(choice);

        if (existingTimer) {
          window.clearTimeout(existingTimer);
          closeTimers.delete(choice);
        }

        closeAllChoices(choice);
        choice.classList.remove('is-closing');

        if (willOpen) {
          choice.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          menu.removeAttribute('hidden');
        } else {
          closeChoice(choice);
        }

        return;
      }

      const option = event.target.closest?.('[data-contact-choice-option]');

      if (option) {
        const choice = option.closest('.contact-choice');
        closeChoice(choice);
        return;
      }

      if (!event.target.closest?.('.contact-choice')) {
        closeAllChoices();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') {
        return;
      }

      const openChoice = document.querySelector('.contact-choice.is-open');

      if (openChoice) {
        closeChoice(openChoice, true);
      }
    });
  }
</script>
