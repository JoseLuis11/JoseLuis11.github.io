---
import type { Service, ValuePoint } from '@data/site';

type IconName = Service['icon'] | ValuePoint['icon'];

type Props = {
  name: IconName;
};

const { name } = Astro.props;
---

<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
  {
    name === 'browser' && (
      <>
        <rect x="4" y="5" width="16" height="12" rx="2" />
        <path d="M4 9h16M8 13h5M8 16h8" />
      </>
    )
  }
  {
    name === 'operations' && (
      <>
        <rect x="4" y="5" width="16" height="14" rx="2" />
        <path d="M8 9h8M8 13h3M14 13h2M8 16h3M14 16h2" />
      </>
    )
  }
  {
    name === 'workflow' && (
      <>
        <path d="M5 6.5h14v9H9l-4 3v-12z" />
        <path d="m13 8.5-2 3h3l-2 3.5" />
      </>
    )
  }
  {
    name === 'support' && (
      <>
        <rect x="5" y="5" width="14" height="10" rx="2" />
        <path d="M8 9h5M8 12h3M12 15v3M8.5 19h7" />
        <path d="m14.5 10.8 1.4 1.4 2.5-3" />
      </>
    )
  }
  {
    name === 'experience' && (
      <>
        <rect x="5" y="7" width="14" height="12" rx="2" />
        <path d="M9 7V5.8A1.8 1.8 0 0 1 10.8 4h2.4A1.8 1.8 0 0 1 15 5.8V7M5 12h14M10 12v2h4v-2" />
      </>
    )
  }
  {
    name === 'focus' && (
      <>
        <circle cx="12" cy="12" r="7" />
        <circle cx="12" cy="12" r="3" />
        <path d="M12 5v3M12 16v3M5 12h3M16 12h3" />
      </>
    )
  }
  {
    name === 'trust' && (
      <>
        <path d="M12 4 18 7v5.5c0 3.4-2.2 6.1-6 7.5-3.8-1.4-6-4.1-6-7.5V7l6-3z" />
        <path d="m9 12 2 2 4-4" />
      </>
    )
  }
</svg>
