---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const whatsappText = 'Hi Solwave, I’m interested in building a software project and would like to learn more.';
const whatsappUrl = `https://wa.me/526462239495?text=${encodeURIComponent(whatsappText)}`;
---

<footer class="site-footer">
  <div class="site-footer__brand">
    <Logo size="sm" />
    <p>Reliable digital solutions built for modern business operations.</p>
  </div>

  <nav class="site-footer__nav" aria-label="Footer navigation">
    <div>
      <h2>Navigation</h2>
      <a href="#home">Home</a>
      <a href="#services">Services</a>
      <a href="#solutions">Solutions</a>
      <a href="#about">About</a>
      <a href="#contact">Contact</a>
    </div>
    <div>
      <h2>Services</h2>
      <a href="#services">Business websites</a>
      <a href="#services">Custom software</a>
      <a href="#services">Automation & communication</a>
      <a href="#services">Technical support & deployment</a>
    </div>
    <div>
      <h2>Resources</h2>
      <a href="mailto:hello@solwave.dev">hello@solwave.dev</a>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href="https://www.linkedin.com/in/jose-luis-castro-132626123" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </nav>

  <p class="site-footer__copyright">&copy; {year} Solwave. All rights reserved.</p>
</footer>
