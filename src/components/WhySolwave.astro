---
import Icon from './Icon.astro';
import type { SiteContent } from '@data/site';

type Props = {
  content: SiteContent['why'];
};

const { content } = Astro.props;
---

<section class="section section-shell why" id="about" aria-labelledby="why-title">
  <div class="why__content">
    <p class="eyebrow">{content.eyebrow}</p>
    <h2 id="why-title">
      {content.title}
      <span>{content.titleAccent}</span>
    </h2>
    <p>
      {content.description}
    </p>
  </div>

  <div class="why__visual" aria-hidden="true">
    <div class="brand-mark"></div>
  </div>

  <div class="why__points">
    {
      content.points.map((point) => (
        <article class="value-point">
          <div class="icon-tile">
            <Icon name={point.icon} />
          </div>
          <div>
            <h3>{point.title}</h3>
            <p>{point.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
