---
import Icon from './Icon.astro';
import { valuePoints } from '@data/site';
---

<section class="section section-shell why" id="about" aria-labelledby="why-title">
  <div class="why__content">
    <p class="eyebrow">Why Solwave</p>
    <h2 id="why-title">
      Engineered for clarity.
      <span>Built for scale.</span>
      <span>Designed to flow.</span>
    </h2>
    <p>
      We combine clean code, modern tools and thoughtful design to deliver software that is
      reliable, maintainable and future-ready.
    </p>
  </div>

  <div class="why__visual" aria-hidden="true">
    <div class="brand-mark"></div>
  </div>

  <div class="why__points">
    {
      valuePoints.map((point) => (
        <article class="value-point">
          <div class="icon-tile">
            <Icon name={point.icon} />
          </div>
          <div>
            <h3>{point.title}</h3>
            <p>{point.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
