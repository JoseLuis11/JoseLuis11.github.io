---
import type { SiteContent } from '@data/site';

type Props = {
  content: SiteContent['clients'];
};

const { content } = Astro.props;
---

<section class="section section-shell clients" id="clients" aria-labelledby="clients-title">
  <div class="section-heading section-heading--center">
    <p class="eyebrow">{content.eyebrow}</p>
    <h2 id="clients-title">{content.title}</h2>
  </div>

  <div class="clients__list">
    {
      content.items.map((client) => (
        <article class="client-card">
          <a
            class="client-card__brand"
            href={client.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={client.linkLabel}
          >
            {client.logo === 'ita' && (
              <div class="ita-wordmark" aria-hidden="true">
                <span class="ita-wordmark__script">ita</span>
                <span class="ita-wordmark__caption">BEAUTY ROOM</span>
              </div>
            )}
            <span class="client-card__external" aria-hidden="true">↗</span>
          </a>
          <div class="client-card__content">
            <p class="client-card__category">{client.category}</p>
            <h3>{client.name}</h3>
            <p class="client-card__description">{client.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
